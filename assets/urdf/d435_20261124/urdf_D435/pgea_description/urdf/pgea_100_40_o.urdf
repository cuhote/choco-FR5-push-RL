<?xml version="1.0"?>
<robot name="pgea_100_40_o">
  <link name="flange"/>

  <!-- ===== DH Robotics PGEA-100-40-O (measured 2026-11-21; see make_pgea_urdf.py for assumed values) ===== -->
  <material name="pgea_black"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="pgea_white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="pgea_alu"><color rgba="0.75 0.75 0.78 1"/></material>
  <joint name="pgea_mount" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="flange"/><child link="pgea_base"/>
  </joint>
  <link name="pgea_base">
    <inertial><origin xyz="0 0 0.065"/><mass value="0.55"/>
      <inertia ixx="0.000755517" ixy="0" ixz="0" iyy="0.000820829" iyz="0" izz="0.000211979"/></inertial>
    <visual name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry><material name="pgea_black"/></visual>
    <collision name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry></collision>
    <visual name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0370 0.0400 0.0900"/></geometry><material name="pgea_black"/></visual>
    <collision name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0370 0.0400 0.0900"/></geometry></collision>
    <visual name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0550 0.0400 0.0220"/></geometry><material name="pgea_alu"/></visual>
    <collision name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0550 0.0400 0.0220"/></geometry></collision>
  </link>
  <link name="finger_left">
    <inertial><origin xyz="0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="../meshes/finger_left.stl"/></geometry><material name="pgea_white"/></visual>
    <collision><geometry><mesh filename="../meshes/finger_left.stl"/></geometry></collision>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_left"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <link name="finger_right">
    <inertial><origin xyz="-0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="../meshes/finger_right.stl"/></geometry><material name="pgea_white"/></visual>
    <collision><geometry><mesh filename="../meshes/finger_right.stl"/></geometry></collision>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_right"/>
    <axis xyz="-1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <!-- TCP = fingertip centre, FR5 tool 1 (0, 0, 160) -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.1600" rpy="0 0 0"/><parent link="pgea_base"/><child link="tcp"/>
  </joint>
  <!-- ===== D435 bracket (3D printed, measured 2026-11-24) + RealSense D435 ===== -->
  <material name="bracket_white"><color rgba="0.96 0.96 0.94 1"/></material>
  <material name="d435_gray"><color rgba="0.62 0.62 0.64 1"/></material>
  <link name="d435_bracket">
    <inertial><origin xyz="0 0.045 0.070"/><mass value="0.08"/>
      <inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="5e-5"/></inertial>
    <visual name="wall"><origin xyz="0.0000 0.0230 0.0470"/><geometry><box size="0.0600 0.0060 0.0740"/></geometry><material name="bracket_white"/></visual>
    <collision name="wall"><origin xyz="0.0000 0.0230 0.0470"/><geometry><box size="0.0600 0.0060 0.0740"/></geometry></collision>
    <visual name="plate"><origin xyz="0.0000 0.0540 0.0775"/><geometry><box size="0.1000 0.0680 0.0130"/></geometry><material name="bracket_white"/></visual>
    <collision name="plate"><origin xyz="0.0000 0.0540 0.0775"/><geometry><box size="0.1000 0.0680 0.0130"/></geometry></collision>
    <visual name="gusset"><geometry><mesh filename="../meshes/bracket_gusset.stl"/></geometry><material name="bracket_white"/></visual>
    <collision name="gusset"><geometry><mesh filename="../meshes/bracket_gusset.stl"/></geometry></collision>
  </link>
  <joint name="d435_bracket_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="pgea_base"/><child link="d435_bracket"/>
  </joint>
  <!-- d435_link = camera body centre; long axis along tool X -->
  <link name="d435_link">
    <inertial><origin xyz="0 0 0"/><mass value="0.072"/>
      <inertia ixx="7.5e-06" ixy="0" ixz="0" iyy="5.0214e-05" iyz="0" izz="5.0214e-05"/></inertial>
    <visual name="body"><origin xyz="0.0000 0.0000 0.0000"/><geometry><box size="0.0880 0.0250 0.0250"/></geometry><material name="d435_gray"/></visual>
    <collision name="body"><origin xyz="0.0000 0.0000 0.0000"/><geometry><box size="0.0880 0.0250 0.0250"/></geometry></collision>
  </link>
  <joint name="d435_joint" type="fixed">
    <origin xyz="0 0.0575 0.0965" rpy="0 0 0"/><parent link="pgea_base"/><child link="d435_link"/>
  </joint>
  <!-- optical frame (REP-103 optical: +Z out of the lens = tool +Z, down) at the lens face centre.
       The real depth origin is the left IR imager, ~17.5 mm off centre along X: calibrate hand-eye before use. -->
  <link name="d435_optical_frame"/>
  <joint name="d435_optical_joint" type="fixed">
    <origin xyz="0 0 0.0125" rpy="0 0 0"/><parent link="d435_link"/><child link="d435_optical_frame"/>
  </joint>
</robot>
