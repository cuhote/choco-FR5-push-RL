<?xml version="1.0"?>
<robot name="pgea_100_40_o">
<link name="world"/>
<link name="lx"><inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial></link>
<link name="ly"><inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial></link>
<link name="lz"><inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial></link>
<link name="flange"><inertial><mass value="0.01"/><inertia ixx="1e-5" iyy="1e-5" izz="1e-5" ixy="0" ixz="0" iyz="0"/></inertial></link>
<joint name="px" type="prismatic"><parent link="world"/><child link="lx"/><axis xyz="1 0 0"/><limit lower="-0.3" upper="0.3" effort="200" velocity="0.5"/></joint>
<joint name="py" type="prismatic"><parent link="lx"/><child link="ly"/><axis xyz="0 1 0"/><limit lower="-0.3" upper="0.3" effort="200" velocity="0.5"/></joint>
<joint name="pz" type="prismatic"><parent link="ly"/><child link="lz"/><axis xyz="0 0 1"/><limit lower="0.0" upper="0.5" effort="200" velocity="0.5"/></joint>
<!-- rpy π: 공구 +Z(손가락 방향)가 아래를 보게 뒤집음 -->
<joint name="yaw" type="revolute"><origin rpy="3.14159 0 0"/><parent link="lz"/><child link="flange"/><axis xyz="0 0 -1"/><limit lower="-3.2" upper="3.2" effort="50" velocity="3"/></joint>
  <!-- ===== DH Robotics PGEA-100-40-O (measured 2026-11-21; see make_pgea_urdf.py for assumed values) ===== -->
  <material name="pgea_black"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="pgea_white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="pgea_alu"><color rgba="0.75 0.75 0.78 1"/></material>
  <joint name="pgea_mount" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/><parent link="flange"/><child link="pgea_base"/>
  </joint>
  <link name="pgea_base">
    <inertial><origin xyz="0 0 0.065"/><mass value="0.55"/>
      <inertia ixx="0.000755517" ixy="0" ixz="0" iyy="0.000820829" iyz="0" izz="0.000211979"/></inertial>
    <visual name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry><material name="pgea_black"/></visual>
    <collision name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry></collision>
    <visual name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0550 0.0230 0.0900"/></geometry><material name="pgea_black"/></visual>
    <collision name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0550 0.0230 0.0900"/></geometry></collision>
    <visual name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0730 0.0230 0.0220"/></geometry><material name="pgea_alu"/></visual>
    <collision name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0730 0.0230 0.0220"/></geometry></collision>
  </link>
  <link name="finger_left">
    <inertial><origin xyz="0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="../meshes/finger_left.stl"/></geometry><material name="pgea_white"/></visual>
    <collision name="jaw"><origin xyz="0.0080 0 0.0025"/><geometry><box size="0.0160 0.0060 0.0050"/></geometry></collision>
    <collision name="upper"><origin xyz="0.0055 0 0.0145"/><geometry><box size="0.0110 0.0140 0.0190"/></geometry></collision>
    <collision name="tip"><geometry><mesh filename="../meshes/finger_left_tip.stl"/></geometry></collision>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_left"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <link name="finger_right">
    <inertial><origin xyz="-0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="../meshes/finger_right.stl"/></geometry><material name="pgea_white"/></visual>
    <collision name="jaw"><origin xyz="-0.0080 0 0.0025"/><geometry><box size="0.0160 0.0060 0.0050"/></geometry></collision>
    <collision name="upper"><origin xyz="-0.0055 0 0.0145"/><geometry><box size="0.0110 0.0140 0.0190"/></geometry></collision>
    <collision name="tip"><geometry><mesh filename="../meshes/finger_right_tip.stl"/></geometry></collision>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_right"/>
    <axis xyz="-1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <!-- TCP = fingertip centre, FR5 tool 1 (0, 0, 160) -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.1600" rpy="0 0 0"/><parent link="pgea_base"/><child link="tcp"/>
  </joint>
  <!-- D435 + bracket: add a fixed camera link here once the mount is measured (design 5.2) -->
</robot>
