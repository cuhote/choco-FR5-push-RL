<?xml version="1.0"?>
<!-- DH Robotics PGEA-100-40-O, measured 2026-11-21 (team CHOCO). Generated by make_ros_pkg.py.
     parent: link the flange face belongs to, xyz: flange face in that link (FR5 wrist3_link -> "0 0 0.100").
     Tool frame = flange face, +Z to the fingertips, fingers open along +-X. tcp link = (0, 0, 160 mm). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="pgea_100_40_o" params="parent xyz:='0 0 0'">

  <!-- ===== DH Robotics PGEA-100-40-O (measured 2026-11-21; see make_pgea_urdf.py for assumed values) ===== -->
  <material name="pgea_black"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="pgea_white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="pgea_alu"><color rgba="0.75 0.75 0.78 1"/></material>
  <joint name="pgea_mount" type="fixed">
    <origin xyz="${xyz}" rpy="0 0 0"/><parent link="${parent}"/><child link="pgea_base"/>
  </joint>
  <link name="pgea_base">
    <inertial><origin xyz="0 0 0.065"/><mass value="0.55"/>
      <inertia ixx="0.000755517" ixy="0" ixz="0" iyy="0.000820829" iyz="0" izz="0.000211979"/></inertial>
    <visual name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry><material name="pgea_black"/></visual>
    <collision name="adapter"><origin xyz="0 0 0.0050"/><geometry><cylinder radius="0.0400" length="0.0100"/></geometry></collision>
    <visual name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0370 0.0400 0.0900"/></geometry><material name="pgea_black"/></visual>
    <collision name="body"><origin xyz="0 0 0.0550"/><geometry><box size="0.0370 0.0400 0.0900"/></geometry></collision>
    <visual name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0550 0.0400 0.0220"/></geometry><material name="pgea_alu"/></visual>
    <collision name="housing"><origin xyz="0 0 0.1110"/><geometry><box size="0.0550 0.0400 0.0220"/></geometry></collision>
  </link>
  <link name="finger_left">
    <inertial><origin xyz="0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="package://pgea_description/meshes/finger_left.stl"/></geometry><material name="pgea_white"/></visual>
    <collision><geometry><mesh filename="package://pgea_description/meshes/finger_left.stl"/></geometry></collision>
  </link>
  <joint name="finger_left_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_left"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <link name="finger_right">
    <inertial><origin xyz="-0.0080 0 0.019"/><mass value="0.03"/>
      <inertia ixx="4.61e-06" ixy="0" ixz="0" iyy="4.25e-06" iyz="0" izz="1.64e-06"/></inertial>
    <visual><geometry><mesh filename="package://pgea_description/meshes/finger_right.stl"/></geometry><material name="pgea_white"/></visual>
    <collision><geometry><mesh filename="package://pgea_description/meshes/finger_right.stl"/></geometry></collision>
  </link>
  <joint name="finger_right_joint" type="prismatic">
    <origin xyz="0 0 0.1220" rpy="0 0 0"/><parent link="pgea_base"/><child link="finger_right"/>
    <axis xyz="-1 0 0"/><limit lower="0" upper="0.0220" effort="100" velocity="0.05"/>
  </joint>
  <!-- TCP = fingertip centre, FR5 tool 1 (0, 0, 160) -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.1600" rpy="0 0 0"/><parent link="pgea_base"/><child link="tcp"/>
  </joint>
  <!-- D435 + bracket: add a fixed camera link here once the mount is measured (design 5.2) -->
  </xacro:macro>
</robot>
