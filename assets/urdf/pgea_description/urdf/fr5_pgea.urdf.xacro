<?xml version="1.0"?>
<!-- FR5 (fairino_description/fairino5_v6.urdf) + PGEA-100-40-O on the flange (wrist3_link z 0.100) -->
<robot name="fairino5_v6_pgea" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find fairino_description)/urdf/fairino5_v6.urdf"/>
  <xacro:include filename="$(find pgea_description)/urdf/pgea_100_40_o.xacro"/>
  <xacro:pgea_100_40_o parent="wrist3_link" xyz="0 0 0.100"/>
</robot>
